{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetaGPT Product Requirements Document (PRD) Schema",
  "type": "object",
  "required": [
    "feature_name",
    "target_domain",
    "problem_statement",
    "user_personas",
    "acceptance_criteria",
    "forbidden_states"
  ],
  "properties": {
    "feature_name": { "type": "string", "minLength": 3 },
    "target_domain": { "type": "string" },
    "problem_statement": { "type": "string", "minLength": 20 },
    "user_personas": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "forbidden_states": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "sla_latency_ms": { "type": "number", "minimum": 0 },
    "security_invariants": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "pipeline/tests/**/*",
    "pipeline/scripts/**/*",
    ".agents/harness/**/*"
  ],
  "exclude": [
    "node_modules",
    ".agents/skills"
  ]
}
